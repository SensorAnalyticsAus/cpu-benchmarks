#!/bin/zsh
echo "Starting CPU-intensive task..."
START_TIME=$(date +%s)
# Perform a computationally intensive task, e.g., calculating prime numbers
# This example calculates prime numbers up to 100,000
for i in $(seq 2 100000); do
    is_prime=true
    limit=$((i**0.5))
    for j in $(seq 2 $limit); do
        if (( i % j == 0 )); then
            is_prime=false
            break
        fi
    done
done
END_TIME=$(date +%s)
# Calculate duration using Zsh's shell arithmetic
DURATION=$((END_TIME - START_TIME))
echo "CPU-intensive task completed in $DURATION seconds[zsh]."
